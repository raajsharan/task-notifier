# --- Database: PostgreSQL ---
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://taskuser:taskpass@localhost:5432/tasknotifier

# --- Auth / JWT ---
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS: your frontend's URL ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Server port ---
PORT=8001
