# --- Database: PostgreSQL ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/tasknotifier

# --- Auth / JWT ---
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS: your frontend's URL ---
FRONTEND_ORIGIN=http://localhost:5173
